import random

text = "I like Python. I like programming. Python is easy."

words = text.replace(".", "").split()
bigrams = {}

for i in range(len(words) - 1):
    bigrams.setdefault(words[i], []).append(words[i + 1])

word = "I"
result = [word]

for i in range(8):
    if word in bigrams:
        word = random.choice(bigrams[word])
        result.append(word)

print(" ".join(result))
