def morphological_parser(word):
    if word.endswith("ing"):
        root = word[:-3]
        suffix = "ing"
    elif word.endswith("ed"):
        root = word[:-2]
        suffix = "ed"
    elif word.endswith("s"):
        root = word[:-1]
        suffix = "s"
    else:
        root = word
        suffix = "None"

    print("Word   :", word)
    print("Root   :", root)
    print("Suffix :", suffix)

word = input("Enter a word: ")
morphological_parser(word)